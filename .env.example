# Serviço de voz (Kokoro + Piper, services/tts). Configure somente no
# ambiente seguro da Vercel. Nunca use prefixo VITE_: isso exporia o
# segredo no navegador. Veja services/tts/README.md para detalhes.
TTS_SERVICE_URL=
TTS_SERVICE_TOKEN=
TTS_TIMEOUT_MS=8000

# Integração com o Google Agenda (leitura). Veja docs/GOOGLE_CALENDAR_SETUP.md
# para o passo a passo de criação das credenciais no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Chave AES-256 em base64 (32 bytes), usada só para cifrar o cookie de sessão
# do Google. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_SESSION_SECRET=

# Modo Sala (multiplayer). Veja docs/ROOM_SETUP.md para o passo a passo de
# criação do projeto Firebase e da conta de serviço.
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
